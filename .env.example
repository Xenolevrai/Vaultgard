# Copier vers agent/.env (jamais commité). Clés de TESTNET uniquement — jamais une clé qui détient de vrais fonds.
# `bash scripts/create-wallets.sh` remplit automatiquement les clés et adresses.

# mock = démo hors-ligne (défaut) | web3 = vrai contrat
CHAIN=mock

# --- Avalanche Fuji (testnet, chainId 43113). Mainnet : https://api.avax.network/ext/bc/C/rpc (chainId 43114)
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VAULT_ADDRESS=
DEPLOY_BLOCK=

# Clés (une par rôle). En PRODUCTION, OWNER_PRIVATE_KEY ne doit PAS être sur le serveur : l'owner signe avec Core Wallet.
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
GUARDIAN_PRIVATE_KEY=

# Adresses publiques
SUPPLIER_ADDRESS=
NEW_SUPPLIER_ADDRESS=
CANARY_ADDRESS=
ATTACKER_ADDRESS=0xbad0000000000000000000000000000000dead00

# --- Serveur (production : voir docs/MISE_EN_PRODUCTION.md)
HOST=127.0.0.1
PORT=8000
# Production : ALLOWED_HOSTS=votre-domaine.fr (sinon 421 sur toutes les requêtes)
ALLOWED_HOSTS=localhost,127.0.0.1
# Ancien admin de la démo (mot de passe seul, SANS 2FA, pilote le coffre « live ») : laisser VIDE en production,
# l'administration passe par le super-admin 2FA (python3 server.py --create-admin).
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=0
TRUST_PROXY=0
# Base SQLite (Docker : /data/vaultguard.db, déjà défini dans l'image) et inscriptions libres (0 = sur invitation)
# DB_PATH=data/vaultguard.db
# SIGNUP_OPEN=1

# --- LLM (optionnel : sans clé, l'agent est scripté)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Boîte de dépôt des factures (agent/mail_agent.py). Tout vide = boîte de démonstration locale
# (dossier agent/data/boite-entrante, voir docs/BOITE-FACTURES.md).
# Modèle d'adresse remise à chaque entreprise ; {alias} est remplacé par son identifiant.
# Démo avec une boîte Gmail de TEST : vaultguard.factures+{alias}@gmail.com
INBOUND_ADDRESS=
INBOUND_IMAP_HOST=
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=
# Gmail : « mot de passe d'application » (16 lettres), jamais le mot de passe du compte.
INBOUND_IMAP_PASSWORD=
# Nom du serveur de réception dans l'en-tête Authentication-Results (Gmail : mx.google.com, rempli tout seul).
INBOUND_AUTHSERV_ID=
# Pour répondre à l'expéditeur avec le verdict (Gmail : smtp.gmail.com, port 465). Vide = pas de réponse.
INBOUND_SMTP_HOST=
INBOUND_SMTP_PORT=465
# Adresse du site citée dans la réponse, ex. https://vaultguard.exemple.fr
PUBLIC_URL=
# 1 = vérifier le SIREN des factures auprès de l'annuaire public des entreprises (recherche-entreprises.api.gouv.fr).
# Laisser vide pour la démonstration : ses entreprises sont fictives.
REGISTRY_CHECK=
