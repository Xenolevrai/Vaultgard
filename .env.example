# Copier vers agent/.env (jamais commité). Clés de TESTNET uniquement — jamais une clé qui détient de vrais fonds.
# `bash scripts/create-wallets.sh` remplit automatiquement les clés et adresses.

# mock = démo hors-ligne (défaut) | web3 = vrai contrat
CHAIN=mock

# --- Avalanche Fuji (testnet, chainId 43113). Mainnet : https://api.avax.network/ext/bc/C/rpc (chainId 43114)
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VAULT_ADDRESS=
DEPLOY_BLOCK=

# Clés (une par rôle). En PRODUCTION, OWNER_PRIVATE_KEY ne doit PAS être sur le serveur : l'owner signe avec Core Wallet.
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
GUARDIAN_PRIVATE_KEY=

# Adresses publiques
SUPPLIER_ADDRESS=
NEW_SUPPLIER_ADDRESS=
CANARY_ADDRESS=
ATTACKER_ADDRESS=0xbad0000000000000000000000000000000dead00

# --- Serveur (production : voir docs/MISE_EN_PRODUCTION.md)
HOST=127.0.0.1
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=0
TRUST_PROXY=0

# --- LLM (optionnel : sans clé, l'agent est scripté)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
