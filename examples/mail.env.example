# Copier vers examples/.env.mail (ignoré par git) et remplir. Utiliser une boîte de TEST, pas ta boîte personnelle.
# Gmail : activer la validation en 2 étapes, puis créer un « mot de passe d'application » (16 lettres) :
#   Compte Google > Sécurité > Validation en 2 étapes > Mots de passe des applications.
# Ce n'est PAS le mot de passe du compte. Il se révoque au même endroit après le hackathon.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Ce que l'agent a le droit de lire :
#   MODE=filtre  (défaut) la boîte ci-dessus en lecture seule, mails non lus dont l'objet contient « facture »
#   MODE=dediee  une adresse créée pour cela (ex. factures-a-payer@entreprise.fr) : l'entreprise y transfère
#                les factures à payer, l'agent ne voit rien d'autre.
MODE=filtre
# MODE=dediee : seules ces adresses peuvent déposer une facture (séparées par des virgules).
EXPEDITEURS_AUTORISES=
# MODE=dediee : 1 = effacer le mail de la boîte une fois traité (rien ne reste en attente).
SUPPRIMER_APRES=0
